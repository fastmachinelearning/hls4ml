# GENERATED by hls4ml.contrib.parameter_banks -- edit the generator, not this file.
#
# Places and routes the @PROJECT_NAME@ IP wrapped with parameter banks, out of context, as a check.
# Writes reports next to this script and creates no project.
#
# Usage:  vivado -mode batch -source create_parameter_banks.tcl

set project_name  @PROJECT_NAME@
set top_name      @TOP_NAME@
set bd_module     @BD_MODULE@
set part          @PART@
set n_banks       @N_BANKS@
set clock_period  @CLOCK_PERIOD@

set here [file normalize [file dirname [info script]]]
set hls_rtl "@HLS_RTL_DIR@"
set wrap_rtl "$here/rtl"

if {![file isdirectory $hls_rtl]} {
    puts "ERROR: exported HLS RTL not found at $hls_rtl -- run build(synth=True) first"
    exit 1
}
foreach f [list bank_addr_mapper.sv bank_select_latch.sv parameter_bank.sv \
                scalar_bank_mux.sv ${top_name}.sv ${bd_module}.v] {
    if {![file exists "$wrap_rtl/$f"]} {
        puts "ERROR: missing generated source $wrap_rtl/$f"
        exit 1
    }
}

create_project -in_memory -part $part

# unmodified HLS IP
add_files -norecurse [glob "$hls_rtl/*.v"]

# The HLS ROMs read ./<name>.dat, copied next to this script. Not add_files'd: Vivado deletes data files added as sources.
cd $here
# synthesized through the Verilog shim, which checks that it matches the wrapper
add_files -norecurse [glob "$wrap_rtl/*.sv"]
set_property file_type SystemVerilog [get_files "$wrap_rtl/*.sv"]
# bank preload images, found by name when $readmemh opens them
foreach mem [glob -nocomplain "$wrap_rtl/*.mem"] { add_files -norecurse $mem }
add_files -norecurse "$wrap_rtl/${bd_module}.v"

set_property top $bd_module [current_fileset]
update_compile_order -fileset sources_1

set xdc "$here/${top_name}_clock.xdc"
set fh [open $xdc w]
puts $fh "create_clock -period $clock_period -name ap_clk \[get_ports ap_clk\]"
close $fh
read_xdc -mode out_of_context $xdc

# a preload image that cannot be found would leave its bank zero
set_msg_config -id {Synth 8-4445} -new_severity ERROR

synth_design -top $bd_module -part $part -mode out_of_context
opt_design
set clock_buffer [lindex [get_sites -quiet -filter {SITE_TYPE == BUFGCTRL}] 0]
if {$clock_buffer ne ""} {
    set_property HD.CLK_SRC $clock_buffer [get_ports ap_clk]
}
place_design
phys_opt_design
route_design

report_utilization -hierarchical -file "$here/utilization.rpt"
report_timing_summary            -file "$here/timing.rpt"
report_drc                       -file "$here/drc.rpt"

puts "parameter-banks wrapper synthesized and routed: top=$top_name bd_module=$bd_module banks=$n_banks part=$part"
