# Synthesize the Verilog generated by HLS with Vivado, out of context and with the clock constrained, and
# optionally place and route it. The reports are written to the current directory:
#   after synthesis:       vivado_synth.rpt (utilization), vivado_synth_timing.rpt
#   after place and route: vivado_impl.rpt (utilization), vivado_impl_timing.rpt, vivado_impl_power.rpt
# The clock constraint is written to vivado_synth.xdc.
#
# Options are given as name=value after -tclargs. Without project.tcl, src, top, part and clock_period must be given.
#   src           directory with the Verilog files (default: the HLS project in project.tcl)
#   top           top module (default: project_name from project.tcl, with _axi for VivadoAccelerator)
#   part          FPGA part (default: part from project.tcl)
#   clock_period  clock period in ns (default: clock_period from project.tcl)
#   pnr           1 to also place and route, 0 to stop after synthesis (default: 0)

array set synth_opt {pnr 0}

set tcldir [file dirname [info script]]
if {[file exists [file join $tcldir project.tcl]]} {
    source [file join $tcldir project.tcl]
    set synth_opt(src) ${project_name}_prj/solution1/syn/verilog
    # VivadoAccelerator wraps the model in an AXI top function
    if {$backend eq "vivadoaccelerator"} {
        set synth_opt(top) ${project_name}_axi
    } else {
        set synth_opt(top) $project_name
    }
    set synth_opt(part) $part
    set synth_opt(clock_period) $clock_period
}

foreach arg $::argv {
    if {[regexp {^(\w+)=(.*)$} $arg unused name value]} {
        set synth_opt($name) $value
    }
}

foreach name {src top part clock_period} {
    if {![info exists synth_opt($name)]} {
        puts "ERROR: $name is not set. Pass $name=<value> after -tclargs."
        exit 1
    }
}

# Remove the reports of an earlier run, so that a run without place and route does not leave old ones behind
file delete -force vivado_synth.rpt vivado_synth_timing.rpt vivado_impl.rpt vivado_impl_timing.rpt vivado_impl_power.rpt

set xdc_file vivado_synth.xdc
set fh [open $xdc_file w]
puts $fh "create_clock -period $synth_opt(clock_period) -name ap_clk \[get_ports ap_clk\]"
close $fh

create_project -in_memory -part $synth_opt(part)
add_files $synth_opt(src)
# HLS writes a script for each AMD IP core the design uses, such as a floating-point operator, that creates the core.
# The in-memory project creates the cores in .srcs and .gen in the current directory. The cores of an earlier run are
# removed first, otherwise Vivado creates new copies next to them.
file delete -force .srcs/sources_1/ip .gen/sources_1/ip
foreach ip_script [glob -nocomplain -directory $synth_opt(src) *_ip.tcl] {
    source $ip_script
}
read_xdc -mode out_of_context $xdc_file
synth_design -top $synth_opt(top) -part $synth_opt(part) -mode out_of_context
# Vivado 2024.1 can leave the cascade input of a DSP unconnected while the DSP still uses it, which the design rule
# check DSPS-2 rejects before routing. Synthesizing adder trees without DSP cascades avoids it.
if {[regexp {DSPS-2#} [report_drc -checks {DSPS-2} -return_string]]} {
    puts "WARNING: Synthesis left a DSP cascade input unconnected (DSPS-2), synthesizing again with -cascade_dsp tree"
    close_design
    synth_design -top $synth_opt(top) -part $synth_opt(part) -mode out_of_context -cascade_dsp tree
}
opt_design -retarget -propconst -sweep -bram_power_opt -shift_register_opt
report_utilization -file vivado_synth.rpt
report_timing_summary -file vivado_synth_timing.rpt

if {$synth_opt(pnr)} {
    # Out of context there is no clock buffer; naming a buffer site as the clock source puts the delay and skew of the
    # clock into the timing analysis
    set clock_buffer [lindex [get_sites -quiet -filter {SITE_TYPE == BUFGCTRL}] 0]
    if {$clock_buffer ne "" && [llength [get_ports -quiet ap_clk]] > 0} {
        set_property HD.CLK_SRC $clock_buffer [get_ports ap_clk]
    }
    place_design
    phys_opt_design
    route_design
    report_utilization -file vivado_impl.rpt
    report_timing_summary -file vivado_impl_timing.rpt
    report_power -file vivado_impl_power.rpt
}
